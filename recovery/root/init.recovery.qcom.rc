# Recovery init for the unified OnePlus 8 / 8 Pro (services for FBE decryption).

# Generated by the qcom_decrypt_fbe module (starts qseecomd, keymaster, gatekeeper).
import /init.recovery.qcom_decrypt.rc

# OPlus cryptoeng HAL. On stock it lives in /odm/bin/hw; extract-files.sh places the binary in /system/bin.
service hal_cryptoeng_oplus /system/bin/vendor.oplus.hardware.cryptoeng@1.0-service
    class late_start
    user system
    group system input sdcard_rw sdcard_r
    seclabel u:r:recovery:s0

# Stock vendor.keymasterd (/vendor/bin/keymasterd). Not started by default; whether decryption needs it is untested.
# Start it by hand: adb shell start vendor.keymasterd
service vendor.keymasterd /system/bin/keymasterd
    class late_start
    user system
    group system
    disabled
    seclabel u:r:recovery:s0

# Sets ro.product.* for the detected variant from ro.boot.prj_version.
service unified-props /system/bin/runatboot.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

on init
    # Initial backlight level (panel max is 4095); the UI level is TW_DEFAULT_BRIGHTNESS
    write /sys/class/backlight/panel0-backlight/brightness 1500
    # Boot HAL service name comes from the boot@1.2 impl package chosen in device.mk
    start boot-hal-1-1
    setprop sys.usb.config adb
    mkdir /dev/fscklogs 0770 root system

on boot
    setprop sys.usb.config adb
    chmod 0755 /system/bin/runatboot.sh
    start unified-props

on fs
    # UFS controller soc/1d84000.ufshc (androidboot.boot_devices)
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    chown root system /dev/fscklogs/log
    chmod 0770 /dev/fscklogs/log
