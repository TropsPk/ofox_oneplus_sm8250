<!-- Minimal recovery vendor manifest: keymaster 4.0, gatekeeper 1.0, OPlus cryptoeng 1.0, extracted from the stock
     IN2015 13.1.0.593 manifests. The boot HAL is NOT declared here on purpose:
     TWRP's etc/Android.mk installs android.hardware.boot@1.1.xml/@1.2.xml into vendor/etc/vintf/manifest/ for A/B builds,
     and declaring it twice risks a libvintf conflict. Untested in recovery. -->
<manifest version="2.0" type="device" target-level="5">
  <hal format="hidl">
    <name>android.hardware.gatekeeper</name>
    <transport>hwbinder</transport>
    <version>1.0</version>
    <interface>
      <name>IGatekeeper</name>
      <instance>default</instance>
    </interface>
    <fqname>@1.0::IGatekeeper/default</fqname>
  </hal>
  <hal format="hidl">
    <name>android.hardware.keymaster</name>
    <transport>hwbinder</transport>
    <version>4.0</version>
    <interface>
      <name>IKeymasterDevice</name>
      <instance>default</instance>
    </interface>
    <fqname>@4.0::IKeymasterDevice/default</fqname>
  </hal>
  <hal format="hidl">
    <name>vendor.oplus.hardware.cryptoeng</name>
    <transport>hwbinder</transport>
    <version>1.0</version>
    <interface>
      <name>ICryptoeng</name>
      <instance>default</instance>
    </interface>
  </hal>
</manifest>
